# Trecho do nome que seleciona as campanhas nas três plataformas (sem diferenciar maiúsculas)
CAMPAIGN_FILTER=correios

# Meta Ads — token com acesso à conta Vip Leilões
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=1059526002159277

# Google Ads — refresh token de um usuário com acesso ao MCC BYB
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
# MCC BYB (login-customer-id)
GOOGLE_ADS_LOGIN_CUSTOMER_ID=6363710958
# Conta Vip Leilões (Automóveis)
GOOGLE_ADS_CUSTOMER_ID=3657362033
# Ações de conversão contadas como lead (nomes exatos, separados por vírgula)
GOOGLE_ADS_LEAD_ACTIONS=Cadastro Vip Leilões,Enviar form lead - Landing Pages,01 GT | Google Ads | Lead,Lead - Novos comitentes

# LinkedIn Ads — token da Marketing API com os escopos r_ads e r_ads_reporting
LINKEDIN_ACCESS_TOKEN=
# Renovação automática (opcional): refresh token do gerador + Client ID e Client Secret do app (aba Auth).
# O access token vale ~60 dias; com estas três variáveis a dash gera outro sozinha. O refresh token vale 12 meses.
LINKEDIN_REFRESH_TOKEN=
LINKEDIN_CLIENT_ID=77cbplxejwawdk
LINKEDIN_CLIENT_SECRET=
# ID numérico da conta de anúncios (Campaign Manager) — conta VIP Leilões
LINKEDIN_AD_ACCOUNT_ID=515257058
# Versão da API (AAAAMM). Opcional
LINKEDIN_API_VERSION=
